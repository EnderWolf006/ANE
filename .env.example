# ANE 2.4: use a dedicated empty PostgreSQL database for a fresh install.
PG_URI=postgres://ane:replace-database-password@host.docker.internal:5432/ane?sslmode=disable
PUBLIC_BASE_URL=http://localhost:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
BIND_ADDRESS=127.0.0.1
PORT=8080
ALLOW_PRIVATE_CALLBACKS=false
TZ=Asia/Shanghai
GOPROXY=https://proxy.golang.org,direct
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
